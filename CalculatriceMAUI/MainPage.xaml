<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatriceMAUI.MainPage"
             BackgroundColor="#1C1C1E"
             Title="Calculatrice">

    <!-- ScrollView racine : évite tout débordement sur petits écrans -->
    <ScrollView Orientation="Vertical">

        <!-- Conteneur centré avec taille MAX (mobile = plein écran, PC = format calculatrice) -->
        <Border StrokeThickness="0"
                BackgroundColor="Transparent"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="420"
                MaximumHeightRequest="750"
                Padding="15,25,15,15">

            <!-- Grid principal : écran en haut (auto), clavier en bas (remplit le reste) -->
            <Grid RowDefinitions="Auto,*" RowSpacing="15">

                <!-- ============ ÉCRAN ============ -->
                <Border Grid.Row="0"
                        BackgroundColor="#2C2C2E"
                        StrokeThickness="0"
                        Padding="20"
                        StrokeShape="RoundRectangle 20"
                        MinimumHeightRequest="140">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">

                        <!-- Opération en cours -->
                        <Label Grid.Row="0"
                               x:Name="LblOperation"
                               Text=""
                               FontSize="18"
                               TextColor="#AEAEB2"
                               HorizontalTextAlignment="End"/>

                        <!-- Résultat -->
                        <Label Grid.Row="1"
                               x:Name="LblResultat"
                               Text="0"
                               FontSize="48"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="End"
                               VerticalTextAlignment="Center"
                               LineBreakMode="TailTruncation"/>

                        <!-- C / DEL -->
                        <HorizontalStackLayout Grid.Row="2"
                                               HorizontalOptions="End"
                                               Spacing="25">
                            <Label x:Name="LblClear" Text="C" FontSize="18"
                                   TextColor="#AEAEB2" FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnClearTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="LblDel" Text="DEL" FontSize="18"
                                   TextColor="#AEAEB2" FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDelTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- ============ CLAVIER ============ -->
                <Grid Grid.Row="1"
                      x:Name="ClavierGrid"
                      RowDefinitions="*,*,*,*,*"
                      ColumnDefinitions="*,*,*,*"
                      RowSpacing="8"
                      ColumnSpacing="8"
                      MinimumHeightRequest="400">
                    <!-- Les boutons sont générés dans le code-behind -->
                </Grid>
            </Grid>
        </Border>
    </ScrollView>
</ContentPage>